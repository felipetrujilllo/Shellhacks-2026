# Normalize every text file to LF in the repo AND in every checkout (Windows included), so the
# Windows laptop and the Macs never flip each other's line endings. `text=auto` lets git skip
# files it detects as binary; this also covers data/seed/desc_projects.csv, which
# pipeline.parse_desc regenerates with LF and which used to need its own rule here.
* text=auto eol=lf

# Treat sponsor documents as binary: no text diffs or line-ending conversion.
*.pdf binary
*.xlsx binary
*.docx binary
