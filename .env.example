# GridWatch environment variables — TEMPLATE ONLY, no real values.
#
# Copy to `.env` (gitignored) and fill in the real values, which are shared
# privately within the team. Never commit real credentials.

# Backend: Postgres connection string for the Tiger Data (Timescale Cloud)
# service with PostGIS enabled. Tiger Data requires SSL; default db is `tsdb`.
# If the password contains @ : / ? # or %, percent-encode it (@ becomes %40) —
# libpq splits the userinfo on the FIRST @, so a raw one breaks the hostname.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Backend: scratch Postgres for the opt-in schema tests in
# backend/tests/test_load.py. Deliberately separate from DATABASE_URL, because
# those tests TRUNCATE and must never be able to reach the shared instance.
# README has the throwaway `postgis/postgis` container command and its creds.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:55432/gridwatch_test

# Backend: allowed CORS origin for the frontend (Vite dev server default).
FRONTEND_ORIGIN=http://localhost:5173

# Backend: Dominion's SCRTP project-description PDF, for the opt-in real-source
# parser test in backend/tests/test_parse_desc.py. Optional — it skips without
# this. The repo copy landed with #2, so the committed path is the default.
DESC_PDF="data/source/Project Listings/Dominion Energy/2024-2028-2million-and-above-project-descriptions.pdf"

# Backend (optional): Snowflake Cortex writes the one-to-two-sentence savings
# note for each flagged pair (backend/pipeline/savings_note.py). Leave these
# empty and the note falls back to the deterministic savings_basis, with a
# warning in the log — nothing crashes. The account URL is your account's
# https://<account-identifier>.snowflakecomputing.com base (no path); the token
# is a Snowflake programmatic access token (PAT), shared privately, never here.
# The model must be available in your Snowflake region.
SNOWFLAKE_ACCOUNT_URL=https://ACCOUNT-IDENTIFIER.snowflakecomputing.com
SNOWFLAKE_PAT=
SNOWFLAKE_CORTEX_MODEL=llama3.1-70b
# The one live Cortex test in backend/tests/test_savings_note.py uses these
# keys but only runs with SNOWFLAKE_LIVE_TEST=1 set in the shell (it costs credits).

# Frontend: base URL of the backend API (uvicorn default).
# Vite only exposes vars prefixed with `VITE_`, and by default it reads `.env`
# from the `frontend/` directory — so put this in `frontend/.env` (or set
# `envDir` in vite.config.ts to point at the repo root).
# Absolute here because dev runs two origins; the deployed build uses the relative
# `/api` from .do/app.yaml instead (README "Custom domain").
VITE_API_URL=http://localhost:8000
